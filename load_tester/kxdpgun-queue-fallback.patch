+/*
+ * Drivers such as sfc, mlx4 and bnx2 report no "combined" channels (or no
+ * ethtool channel support at all), so knot_eth_queues() falls back to 1 and
+ * kxdpgun runs a single thread on queue 0. Use one thread per CPU instead,
+ * limited to the RX queues the kernel exposes in sysfs, because thread N binds
+ * to queue N and fails to start without one.
+ */
+static int sysfs_rx_queues(const char *devname)
+{
+	char path[256];
+	snprintf(path, sizeof(path), "/sys/class/net/%s/queues", devname);
+	DIR *dir = opendir(path);
+	if (dir == NULL) {
+		return 0;
+	}
+	int count = 0;
+	struct dirent *ent;
+	while ((ent = readdir(dir)) != NULL) {
+		if (strncmp(ent->d_name, "rx-", 3) == 0) {
+			count++;
+		}
+	}
+	closedir(dir);
+	return count;
+}
+
 _public_
 int knot_eth_queues(const char *devname)
 {
@@ -31,6 +59,12 @@
